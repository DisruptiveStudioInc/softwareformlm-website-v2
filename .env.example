# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Your Website"
MAIL_TO_ADDRESS=contact@example.com

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
RECAPTCHA_SCORE_THRESHOLD=0.5

# WordPress Headless CMS
WP_API_URL=http://localhost:10008/graphql
# Application Password authentication (required when "Restrict Endpoint to Authenticated Users" is enabled in WPGraphQL)
# Generate an Application Password in WordPress: Users > Your Profile > Application Passwords
WP_APP_USER=your-wordpress-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Cache Clear Token (for webhook)
CACHE_CLEAR_TOKEN=your-secret-token-here