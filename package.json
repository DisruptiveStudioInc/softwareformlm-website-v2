{
  "name": "software-for-mlm",
  "version": "1.0.0",
  "description": "Services for MLM Companies",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "tailwindcss -i ./public/assets/css/tailwind-config.css -o ./public/assets/css/styles.css --watch",
    "build": "php ./scripts/build-icons.php && node ./scripts/build-responsive-images.mjs && tailwindcss -i ./public/assets/css/tailwind-config.css -o ./public/assets/css/styles.css --minify",
    "build:icons": "php ./scripts/build-icons.php",
    "build:images": "node ./scripts/build-responsive-images.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
